generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TrayStore {
  id                    String         @id @default(cuid())
  storeId               String         @unique @map("store_id")
  storeHost             String?        @map("store_host")
  apiAddress            String         @map("api_address")
  adminUser             String?        @map("admin_user")
  accessTokenEnc        String         @map("access_token_enc")
  refreshTokenEnc       String         @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime       @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime       @map("refresh_token_expires_at")
  active                Boolean        @default(true)
  installedAt           DateTime       @default(now()) @map("installed_at")
  lastSyncAt            DateTime?      @map("last_sync_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  orders                Order[]
  goals                 Goal[]
  goalLevels            GoalLevel[]
  goalAchievements      GoalAchievement[]
  dailyGoalAchievements DailyGoalAchievement[]
  webhookEvents         WebhookEvent[]
  syncLogs              SyncLog[]

  @@index([active])
  @@map("tray_stores")
}

model Order {
  id            String    @id @default(cuid())
  storeRecordId String    @map("store_record_id")
  trayOrderId   String    @map("tray_order_id")
  orderDate     DateTime  @map("order_date")
  modifiedAt    DateTime? @map("modified_at")
  status        String
  statusType    String?   @map("status_type")
  total         Decimal   @default(0) @db.Decimal(14, 2)
  pointSale     String?   @map("point_sale")
  externalCode  String?   @map("external_code")
  customerId    String?   @map("customer_id")
  raw           Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  store         TrayStore @relation(fields: [storeRecordId], references: [id], onDelete: Cascade)

  @@unique([storeRecordId, trayOrderId])
  @@index([storeRecordId, orderDate])
  @@index([storeRecordId, modifiedAt])
  @@map("orders")
}

model Goal {
  id            String    @id @default(cuid())
  storeRecordId String    @map("store_record_id")
  year          Int
  month         Int
  targetOrders  Int       @map("target_orders")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  store         TrayStore @relation(fields: [storeRecordId], references: [id], onDelete: Cascade)

  @@unique([storeRecordId, year, month])
  @@index([storeRecordId, year, month])
  @@map("goals")
}


model GoalLevel {
  id            String           @id @default(cuid())
  storeRecordId String           @map("store_record_id")
  year          Int
  month         Int
  position      Int
  label         String
  targetOrders  Int              @map("target_orders")
  createdBy     String?          @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  store         TrayStore        @relation(fields: [storeRecordId], references: [id], onDelete: Cascade)
  achievement       GoalAchievement?
  dailyAchievements DailyGoalAchievement[]

  @@unique([storeRecordId, year, month, position])
  @@unique([storeRecordId, year, month, targetOrders])
  @@index([storeRecordId, year, month, position])
  @@map("goal_levels")
}

model GoalAchievement {
  id            String    @id @default(cuid())
  goalLevelId   String    @unique @map("goal_level_id")
  storeRecordId String    @map("store_record_id")
  orderCount    Int       @map("order_count")
  achievedAt    DateTime  @default(now()) @map("achieved_at")
  goalLevel     GoalLevel @relation(fields: [goalLevelId], references: [id], onDelete: Cascade)
  store         TrayStore @relation(fields: [storeRecordId], references: [id], onDelete: Cascade)

  @@index([storeRecordId, achievedAt])
  @@map("goal_achievements")
}

model DailyGoalAchievement {
  id            String    @id @default(cuid())
  storeRecordId String    @map("store_record_id")
  goalLevelId   String    @map("goal_level_id")
  year          Int
  month         Int
  day           Int
  targetOrders  Int       @map("target_orders")
  orderCount    Int       @map("order_count")
  achievedAt    DateTime  @default(now()) @map("achieved_at")
  store         TrayStore @relation(fields: [storeRecordId], references: [id], onDelete: Cascade)
  goalLevel     GoalLevel @relation(fields: [goalLevelId], references: [id], onDelete: Cascade)

  @@unique([storeRecordId, year, month, day, goalLevelId])
  @@index([storeRecordId, year, month, day])
  @@index([goalLevelId, achievedAt])
  @@map("daily_goal_achievements")
}

model WebhookEvent {
  id            String     @id @default(cuid())
  storeRecordId String?    @map("store_record_id")
  sellerId      String     @map("seller_id")
  scopeName     String     @map("scope_name")
  scopeId       String     @map("scope_id")
  action        String
  fingerprint   String     @unique
  payload       Json
  status        String     @default("pending")
  attempts      Int        @default(0)
  error         String?
  nextAttemptAt DateTime?   @map("next_attempt_at")
  lastAttemptAt DateTime?   @map("last_attempt_at")
  receivedAt    DateTime   @default(now()) @map("received_at")
  processedAt   DateTime?  @map("processed_at")
  store         TrayStore? @relation(fields: [storeRecordId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([sellerId, scopeName, scopeId])
  @@map("webhook_events")
}

model SyncLog {
  id            String    @id @default(cuid())
  storeRecordId String    @map("store_record_id")
  kind          String
  status        String
  items         Int       @default(0)
  pages         Int       @default(0)
  message       String?
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  store         TrayStore @relation(fields: [storeRecordId], references: [id], onDelete: Cascade)

  @@index([storeRecordId, startedAt])
  @@map("sync_logs")
}
