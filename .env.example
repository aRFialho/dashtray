# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
SYNC_CRON=0 * * * *
STATUS=*

# Neon. Use a pooled URL for DATABASE_URL and a direct URL for DIRECT_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Tray application credentials. Never commit real values.
TRAY_CONSUMER_KEY=
TRAY_CONSUMER_SECRET=
TRAY_WEBHOOK_TOKEN=
TRAY_ALLOWED_HOSTNAMES=www.drossiinteriores.com.br,drossiinteriores.com.br,*.commercesuite.com.br,*.tray.com.br

# Security
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD_HASH=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
